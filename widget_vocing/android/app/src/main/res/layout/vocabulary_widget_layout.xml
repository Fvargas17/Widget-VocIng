<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card_background">

    <!-- `layout_height="0dp"` + `layout_weight="1"` le da a este bloque toda
         la altura sobrante del widget: crece o se achica según cuánto texto
         haya, pero nunca empuja la fila de botones de abajo (esa se queda en
         `wrap_content`, sin weight, siempre pegada al fondo). El texto que no
         quepa se recorta con `ellipsize` en vez de desplazar nada. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2B2B2B"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_pronunciation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="italic"
            android:gravity="center"
            android:textColor="#5C5C52"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#2B2B2B"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:weightSum="3">

        <Button
            android:id="@+id/widget_btn_previous"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_background"
            android:text="◀"
            android:textSize="16sp"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/widget_btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_background"
            android:text="▶"
            android:textSize="16sp"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/widget_btn_learned"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_background"
            android:text="✓"
            android:textSize="16sp"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>
